# Model checkpoints -- large binaries, not results. Flagship model
# release goes to HuggingFace (deliverable #1), not GitHub. The small
# per-model RESULT files (predictions, glossary/AfriCOMET reports,
# metrics) are tracked -- only the model weights/tokenizer/config
# artifacts inside each output_*/ directory are excluded, via the
# negation patterns below.
output_*/*
!output_*/test_predictions.csv
!output_*/predictions.csv
!output_*/glossary_report.json
!output_*/metrics.json
!output_*/per_term_glosses.csv
!output_*/africomet_report.json
baseline_runs/
output/

# Superseded, pre-fix runs (wrong LR/prefix/language-token). Real
# project history, kept locally, but only actual results belong on
# GitHub -- the incidents themselves stay documented in
# BENCHMARK_REPORT.md regardless.
results_baseline_*/

# Third-party clone from the Pidgin-UNMT investigation (§9.1) -- not
# this project's own code.
external/

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
